# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file or put API keys in frontend code.
TMDB_READ_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
ENABLE_PUBLIC_AI=false
AI_PER_IP_LIMIT=20
AI_GLOBAL_LIMIT=500
PORT=3001
